units           metal
dimension       3
boundary        p p p
atom_style      atomic

lattice         fcc 4.05
region          box block 0 10 0 10 0 10
create_box      1 box
create_atoms    1 box

pair_style      eam/alloy
pair_coeff      * * ../potentials/Al99.eam.alloy Al

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

thermo          50
thermo_style    custom step pe lx ly lz pxx pyy pzz pxy
fix             1 all box/relax iso 0.0 vmax 0.001
min_style       cg
minimize        0.0 1.0e-10 2000 10000
unfix           1

run             0
variable        a0 equal lx/10.0
variable        sxx0 equal -pxx*1.0e-4
variable        syy0 equal -pyy*1.0e-4
variable        szz0 equal -pzz*1.0e-4
variable        sxy0 equal -pxy*1.0e-4

print           "state,eps,a0_A,sxx_GPa,syy_GPa,szz_GPa,sxy_GPa" file al_0K_stresses.csv screen no
print           "eq,0.0,${a0},${sxx0},${syy0},${szz0},${sxy0}" append al_0K_stresses.csv screen no

write_restart   restart.Al_eq
write_dump      all custom dump.Al_eq.lammpstrj id type x y z

clear
read_restart    restart.Al_eq
pair_style      eam/alloy
pair_coeff      * * ../potentials/Al99.eam.alloy Al
thermo_style    custom step pe lx ly lz pxx pyy pzz pxy
change_box      all x scale 1.001 remap
min_style       cg
minimize        0.0 1.0e-10 2000 10000
run             0
variable        a0 equal lx/10.0
variable        sxx equal -pxx*1.0e-4
variable        syy equal -pyy*1.0e-4
variable        szz equal -pzz*1.0e-4
variable        sxy equal -pxy*1.0e-4
print           "exx_pos,0.001,${a0},${sxx},${syy},${szz},${sxy}" append al_0K_stresses.csv screen no

clear
read_restart    restart.Al_eq
pair_style      eam/alloy
pair_coeff      * * ../potentials/Al99.eam.alloy Al
thermo_style    custom step pe lx ly lz pxx pyy pzz pxy
change_box      all x scale 0.999 remap
min_style       cg
minimize        0.0 1.0e-10 2000 10000
run             0
variable        a0 equal lx/10.0
variable        sxx equal -pxx*1.0e-4
variable        syy equal -pyy*1.0e-4
variable        szz equal -pzz*1.0e-4
variable        sxy equal -pxy*1.0e-4
print           "exx_neg,-0.001,${a0},${sxx},${syy},${szz},${sxy}" append al_0K_stresses.csv screen no

clear
read_restart    restart.Al_eq
pair_style      eam/alloy
pair_coeff      * * ../potentials/Al99.eam.alloy Al
thermo_style    custom step pe lx ly lz pxx pyy pzz pxy
change_box      all triclinic
variable        dxy equal 0.001*ly
change_box      all xy delta ${dxy} remap
min_style       cg
minimize        0.0 1.0e-10 2000 10000
run             0
variable        a0 equal lx/10.0
variable        sxx equal -pxx*1.0e-4
variable        syy equal -pyy*1.0e-4
variable        szz equal -pzz*1.0e-4
variable        sxy equal -pxy*1.0e-4
print           "gxy_pos,0.001,${a0},${sxx},${syy},${szz},${sxy}" append al_0K_stresses.csv screen no

clear
read_restart    restart.Al_eq
pair_style      eam/alloy
pair_coeff      * * ../potentials/Al99.eam.alloy Al
thermo_style    custom step pe lx ly lz pxx pyy pzz pxy
change_box      all triclinic
variable        dxy equal -0.001*ly
change_box      all xy delta ${dxy} remap
min_style       cg
minimize        0.0 1.0e-10 2000 10000
run             0
variable        a0 equal lx/10.0
variable        sxx equal -pxx*1.0e-4
variable        syy equal -pyy*1.0e-4
variable        szz equal -pzz*1.0e-4
variable        sxy equal -pxy*1.0e-4
print           "gxy_neg,-0.001,${a0},${sxx},${syy},${szz},${sxy}" append al_0K_stresses.csv screen no

units           metal
dimension       3
boundary        p p p
atom_style      atomic

lattice         custom 4.3596 &
                a1 1.0 0.0 0.0 a2 0.0 1.0 0.0 a3 0.0 0.0 1.0 &
                basis 0.0 0.0 0.0 basis 0.0 0.5 0.5 basis 0.5 0.0 0.5 basis 0.5 0.5 0.0 &
                basis 0.25 0.25 0.25 basis 0.25 0.75 0.75 basis 0.75 0.25 0.75 basis 0.75 0.75 0.25

region          box block 0 8 0 8 0 8
create_box      2 box
create_atoms    1 box basis 1 1 basis 2 1 basis 3 1 basis 4 1 basis 5 2 basis 6 2 basis 7 2 basis 8 2

mass            1 28.0855
mass            2 12.0110

pair_style      tersoff
pair_coeff      * * ../potentials/SiC.tersoff Si C

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

thermo          50
thermo_style    custom step pe lx ly lz pxx pyy pzz pxy
fix             1 all box/relax iso 0.0 vmax 0.001
min_style       cg
minimize        0.0 1.0e-10 2000 10000
unfix           1

run             0
variable        a0 equal lx/8.0
variable        sxx0 equal -pxx*1.0e-4
variable        syy0 equal -pyy*1.0e-4
variable        szz0 equal -pzz*1.0e-4
variable        sxy0 equal -pxy*1.0e-4

print           "state,eps,a0_A,sxx_GPa,syy_GPa,szz_GPa,sxy_GPa" file sic_0K_stresses.csv screen no
print           "eq,0.0,${a0},${sxx0},${syy0},${szz0},${sxy0}" append sic_0K_stresses.csv screen no

write_restart   restart.SiC_eq
write_dump      all custom dump.SiC_eq.lammpstrj id type x y z

clear
read_restart    restart.SiC_eq
pair_style      tersoff
pair_coeff      * * ../potentials/SiC.tersoff Si C
thermo_style    custom step pe lx ly lz pxx pyy pzz pxy
change_box      all x scale 1.001 remap
min_style       cg
minimize        0.0 1.0e-10 2000 10000
run             0
variable        a0 equal lx/8.0
variable        sxx equal -pxx*1.0e-4
variable        syy equal -pyy*1.0e-4
variable        szz equal -pzz*1.0e-4
variable        sxy equal -pxy*1.0e-4
print           "exx_pos,0.001,${a0},${sxx},${syy},${szz},${sxy}" append sic_0K_stresses.csv screen no

clear
read_restart    restart.SiC_eq
pair_style      tersoff
pair_coeff      * * ../potentials/SiC.tersoff Si C
thermo_style    custom step pe lx ly lz pxx pyy pzz pxy
change_box      all x scale 0.999 remap
min_style       cg
minimize        0.0 1.0e-10 2000 10000
run             0
variable        a0 equal lx/8.0
variable        sxx equal -pxx*1.0e-4
variable        syy equal -pyy*1.0e-4
variable        szz equal -pzz*1.0e-4
variable        sxy equal -pxy*1.0e-4
print           "exx_neg,-0.001,${a0},${sxx},${syy},${szz},${sxy}" append sic_0K_stresses.csv screen no

clear
read_restart    restart.SiC_eq
pair_style      tersoff
pair_coeff      * * ../potentials/SiC.tersoff Si C
thermo_style    custom step pe lx ly lz pxx pyy pzz pxy
change_box      all triclinic
variable        dxy equal 0.001*ly
change_box      all xy delta ${dxy} remap
min_style       cg
minimize        0.0 1.0e-10 2000 10000
run             0
variable        a0 equal lx/8.0
variable        sxx equal -pxx*1.0e-4
variable        syy equal -pyy*1.0e-4
variable        szz equal -pzz*1.0e-4
variable        sxy equal -pxy*1.0e-4
print           "gxy_pos,0.001,${a0},${sxx},${syy},${szz},${sxy}" append sic_0K_stresses.csv screen no

clear
read_restart    restart.SiC_eq
pair_style      tersoff
pair_coeff      * * ../potentials/SiC.tersoff Si C
thermo_style    custom step pe lx ly lz pxx pyy pzz pxy
change_box      all triclinic
variable        dxy equal -0.001*ly
change_box      all xy delta ${dxy} remap
min_style       cg
minimize        0.0 1.0e-10 2000 10000
run             0
variable        a0 equal lx/8.0
variable        sxx equal -pxx*1.0e-4
variable        syy equal -pyy*1.0e-4
variable        szz equal -pzz*1.0e-4
variable        sxy equal -pxy*1.0e-4
print           "gxy_neg,-0.001,${a0},${sxx},${syy},${szz},${sxy}" append sic_0K_stresses.csv screen no

LAMMPS (23 Jun 2022 - Update 1)
units           metal
dimension       3
boundary        p p s
atom_style      atomic

read_restart    ../03_interface_eq/restart.interface_300K
Reading restart file ...
  restart file = 23 Jun 2022, LAMMPS = 23 Jun 2022
  restoring atom style atomic from restart
  orthogonal box = (-0.13382692 -0.13382692 0.58571507) to (25.984358 25.984358 73.822431)
  1 by 1 by 1 MPI processor grid
  pair style hybrid stores no restart info
  3924 atoms
  read_restart CPU = 0.003 seconds

pair_style      hybrid eam/alloy tersoff morse 8.0
pair_coeff      * * eam/alloy ../potentials/Al99.eam.alloy Al NULL NULL
pair_coeff      * * tersoff ../potentials/SiC.tersoff NULL Si C
Reading tersoff potential file ../potentials/SiC.tersoff with DATE: 2011-04-26
pair_coeff      1 2 morse 0.4824 1.322 2.920 8.0
pair_coeff      1 3 morse 0.4691 1.738 2.246 8.0

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

group           g_al  type 1
1620 atoms in group g_al
group           g_sic type 2 3
2304 atoms in group g_sic

variable        zmin     equal bound(all,zmin)
variable        zmax     equal bound(all,zmax)
variable        zsic_top equal bound(g_sic,zmax)
variable        zal_bot  equal bound(g_al,zmin)

variable        z_bot_hi     equal ${zmin}+6.0
variable        z_bot_hi     equal 0.595151479249577+6.0
variable        z_top_lo     equal ${zmax}-6.0
variable        z_top_lo     equal 73.812995033337-6.0
variable        z_sic_if_lo  equal ${zsic_top}-4.5
variable        z_sic_if_lo  equal 34.3768405028655-4.5
variable        z_al_if_hi   equal ${zal_bot}+4.5
variable        z_al_if_hi   equal 34.6117472110027+4.5
variable        z_sic_mid_lo equal ${zsic_top}-14.0
variable        z_sic_mid_lo equal 34.3768405028655-14.0
variable        z_sic_mid_hi equal ${zsic_top}-8.0
variable        z_sic_mid_hi equal 34.3768405028655-8.0
variable        z_al_mid_lo  equal ${zal_bot}+8.0
variable        z_al_mid_lo  equal 34.6117472110027+8.0
variable        z_al_mid_hi  equal ${zal_bot}+14.0
variable        z_al_mid_hi  equal 34.6117472110027+14.0

region          r_bot     block INF INF INF INF INF ${z_bot_hi} units box
region          r_bot     block INF INF INF INF INF 6.59515147924958 units box
region          r_top     block INF INF INF INF ${z_top_lo} INF units box
region          r_top     block INF INF INF INF 67.812995033337 INF units box
region          r_sic_if  block INF INF INF INF ${z_sic_if_lo} INF units box
region          r_sic_if  block INF INF INF INF 29.8768405028655 INF units box
region          r_al_if   block INF INF INF INF INF ${z_al_if_hi} units box
region          r_al_if   block INF INF INF INF INF 39.1117472110027 units box
region          r_sic_mid block INF INF INF INF ${z_sic_mid_lo} ${z_sic_mid_hi} units box
region          r_sic_mid block INF INF INF INF 20.3768405028655 ${z_sic_mid_hi} units box
region          r_sic_mid block INF INF INF INF 20.3768405028655 26.3768405028655 units box
region          r_al_mid  block INF INF INF INF ${z_al_mid_lo} ${z_al_mid_hi} units box
region          r_al_mid  block INF INF INF INF 42.6117472110027 ${z_al_mid_hi} units box
region          r_al_mid  block INF INF INF INF 42.6117472110027 48.6117472110027 units box

group           bot_grip  region r_bot
432 atoms in group bot_grip
group           top_grip  region r_top
245 atoms in group top_grip
group           grips     union bot_grip top_grip
677 atoms in group grips
group           mobile    subtract all grips
3247 atoms in group mobile

group           tmp1      region r_sic_if
1919 atoms in group tmp1
group           sic_iface intersect g_sic tmp1
299 atoms in group sic_iface
group           tmp2      region r_al_if
2519 atoms in group tmp2
group           al_iface  intersect g_al tmp2
215 atoms in group al_iface

group           tmp3      region r_sic_mid
360 atoms in group tmp3
group           sic_mid   intersect g_sic tmp3
360 atoms in group sic_mid
group           tmp4      region r_al_mid
243 atoms in group tmp4
group           al_mid    intersect g_al tmp4
243 atoms in group al_mid

reset_timestep  0
timestep        ${dt_val}
timestep        0.001

velocity        bot_grip set 0.0 0.0 0.0
velocity        top_grip set 0.0 0.0 ${vel}
velocity        top_grip set 0.0 0.0 0.10

compute         T_mob mobile temp/partial 1 1 0
compute         ftop  top_grip reduce sum fx fy fz
compute         fbot  bot_grip reduce sum fx fy fz

fix             1 mobile nvt temp 300.0 300.0 0.1
fix_modify      1 temp T_mob
WARNING: Temperature for fix modify is not for group all (src/fix_nh.cpp:1423)
fix             2 top_grip move linear 0.0 0.0 ${vel} units box
fix             2 top_grip move linear 0.0 0.0 0.10 units box

variable        d_if_init equal xcm(al_iface,z)-xcm(sic_iface,z)
variable        d_cz_init equal xcm(al_mid,z)-xcm(sic_mid,z)
variable        d_if0     equal ${d_if_init}
variable        d_if0     equal 4.25238823486882
variable        d_cz0     equal ${d_cz_init}
variable        d_cz0     equal 21.9450667496202

variable        A_area equal lx*ly
variable        u_grip equal step*dt*${vel}
variable        u_grip equal step*dt*0.10
variable        tn_top equal -c_ftop[3]/v_A_area*160.2176634
variable        tn_bot equal  c_fbot[3]/v_A_area*160.2176634
variable        tn_avg equal  0.5*(v_tn_top+v_tn_bot)
variable        d_if   equal  (xcm(al_iface,z)-xcm(sic_iface,z))-${d_if0}
variable        d_if   equal  (xcm(al_iface,z)-xcm(sic_iface,z))-4.25238823486882
variable        d_cz   equal  (xcm(al_mid,z)-xcm(sic_mid,z))-${d_cz0}
variable        d_cz   equal  (xcm(al_mid,z)-xcm(sic_mid,z))-21.9450667496202

fix             out all ave/time 1 ${ave_n} ${ave_n} v_u_grip v_d_if v_d_cz v_tn_avg v_tn_top v_tn_bot c_T_mob file modeI_v${vtag}.dat
fix             out all ave/time 1 200 ${ave_n} v_u_grip v_d_if v_d_cz v_tn_avg v_tn_top v_tn_bot c_T_mob file modeI_v${vtag}.dat
fix             out all ave/time 1 200 200 v_u_grip v_d_if v_d_cz v_tn_avg v_tn_top v_tn_bot c_T_mob file modeI_v${vtag}.dat
fix             out all ave/time 1 200 200 v_u_grip v_d_if v_d_cz v_tn_avg v_tn_top v_tn_bot c_T_mob file modeI_v0p10.dat

variable        dfreq equal floor(${nsteps}/30)
variable        dfreq equal floor(80000/30)
dump            1 all custom ${dfreq} dump.modeI_v${vtag}.lammpstrj id type x y z
dump            1 all custom 2666 dump.modeI_v${vtag}.lammpstrj id type x y z
dump            1 all custom 2666 dump.modeI_v0p10.lammpstrj id type x y z
dump_modify     1 sort id

thermo          2000
thermo_style    custom step v_u_grip v_d_cz v_tn_avg v_tn_top v_tn_bot c_T_mob pe

run             ${nsteps}
run             80000

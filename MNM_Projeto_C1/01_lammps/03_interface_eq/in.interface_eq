# ==============================================================================
# Relaxacao 0 K e Equilibracao NPT 300 K da Interface Al(100) / 3C-SiC(100)
# ==============================================================================
units           metal
dimension       3
boundary        p p s
atom_style      atomic

read_data       data.Al_SiC_init

# Potencial hibrido: EAM (Al-Al) + Tersoff (Si-C) + Morse (Al-Si, Al-C)
pair_style      hybrid eam/alloy tersoff morse 8.0
pair_coeff      * * eam/alloy ../potentials/Al99.eam.alloy Al NULL NULL
pair_coeff      * * tersoff ../potentials/SiC.tersoff NULL Si C
pair_coeff      1 2 morse 0.4824 1.322 2.920 8.0
pair_coeff      1 3 morse 0.4691 1.738 2.246 8.0

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# 1. Minimizacao de energia a 0 K (ajusta espacamento da interface)
thermo          100
thermo_style    custom step temp pe etotal lx ly pxx pyy
min_style       cg
minimize        0.0 1.0e-8 3000 15000

write_restart   restart.interface_0K
write_data      data.interface_0K
write_dump      all custom dump.interface_0K.lammpstrj id type x y z

# 2. Equilibracao termica a 300 K (20 ps, dt = 1 fs) com pressao lateral nula
reset_timestep  0
timestep        0.001

velocity        all create 300.0 492845 mom yes rot yes dist gaussian

fix             1 all npt temp 300.0 300.0 0.1 x 0.0 0.0 1.0 y 0.0 0.0 1.0 couple xy

# Registo da evolucao termodinamica para verificacao VVUQ
variable        t_ps equal step*dt
variable        T equal temp
variable        pe_eV equal pe
variable        Lx equal lx
variable        Pxx_GPa equal pxx*1.0e-4
variable        Pyy_GPa equal pyy*1.0e-4
fix             log_eq all print 100 "${t_ps} ${T} ${pe_eV} ${Lx} ${Pxx_GPa} ${Pyy_GPa}" file eq_thermo.dat screen no title "# t_ps Temp_K PE_eV Lx_A Pxx_GPa Pyy_GPa"

dump            1 all custom 1000 dump.interface_eq.lammpstrj id type x y z
dump_modify     1 sort id

thermo          1000
run             20000

unfix           1
unfix           log_eq
undump          1

write_restart   restart.interface_300K
write_data      data.interface_300K

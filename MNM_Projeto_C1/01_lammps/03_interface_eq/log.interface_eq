LAMMPS (23 Jun 2022 - Update 1)
# ==============================================================================
# Relaxacao 0 K e Equilibracao NPT 300 K da Interface Al(100) / 3C-SiC(100)
# ==============================================================================
units           metal
dimension       3
boundary        p p s
atom_style      atomic

read_data       data.Al_SiC_init
Reading data file ...
  orthogonal box = (0 0 -10) to (25.850531 25.850531 84.364068)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  3924 atoms
  read_data CPU = 0.015 seconds

# Potencial hibrido: EAM (Al-Al) + Tersoff (Si-C) + Morse (Al-Si, Al-C)
pair_style      hybrid eam/alloy tersoff morse 8.0
pair_coeff      * * eam/alloy ../potentials/Al99.eam.alloy Al NULL NULL
pair_coeff      * * tersoff ../potentials/SiC.tersoff NULL Si C
Reading tersoff potential file ../potentials/SiC.tersoff with DATE: 2011-04-26
pair_coeff      1 2 morse 0.4824 1.322 2.920 8.0
pair_coeff      1 3 morse 0.4691 1.738 2.246 8.0

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# 1. Minimizacao de energia a 0 K (ajusta espacamento da interface)
thermo          100
thermo_style    custom step temp pe etotal lx ly pxx pyy
min_style       cg
minimize        0.0 1.0e-8 3000 15000

write_restart   restart.interface_0K
System init for write_restart ...
write_data      data.interface_0K
System init for write_data ...
write_dump      all custom dump.interface_0K.lammpstrj id type x y z

# 2. Equilibracao termica a 300 K (20 ps, dt = 1 fs) com pressao lateral nula
reset_timestep  0
timestep        0.001

velocity        all create 300.0 492845 mom yes rot yes dist gaussian

fix             1 all npt temp 300.0 300.0 0.1 x 0.0 0.0 1.0 y 0.0 0.0 1.0 couple xy

# Registo da evolucao termodinamica para verificacao VVUQ
variable        t_ps equal step*dt
variable        T equal temp
variable        pe_eV equal pe
variable        Lx equal lx
variable        Pxx_GPa equal pxx*1.0e-4
variable        Pyy_GPa equal pyy*1.0e-4
fix             log_eq all print 100 "${t_ps} ${T} ${pe_eV} ${Lx} ${Pxx_GPa} ${Pyy_GPa}" file eq_thermo.dat screen no title "# t_ps Temp_K PE_eV Lx_A Pxx_GPa Pyy_GPa"

dump            1 all custom 1000 dump.interface_eq.lammpstrj id type x y z
dump_modify     1 sort id

thermo          1000
run             20000
